<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raven BD | Premium Fashion & Streetwear Catalogue</title>
    
    <!-- SEO & Open Graph Meta Tags -->
    <meta name="description" content="Discover Raven BD - Premium clothing brand offering stylish streetwear, men's & women's fashion, t-shirts, trousers, and casual wear in Bangladesh.">
    <meta name="keywords" content="Raven BD, clothing brand Bangladesh, streetwear, men fashion, women fashion, t-shirts, Sirajganj fashion">
    <meta property="og:title" content="Raven BD | Our Collection, Your Vibe">
    <meta property="og:description" content="Explore simple, stylish, and elegant fashion catalogue by Raven BD. Order directly via WhatsApp.">
    <meta property="og:type" content="website">

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind CSS (CDN for rapid styling) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ravenRed: '#f44336',
                        ravenDarkRed: '#d32f2f',
                        ravenBlack: '#0f0f11',
                        ravenGray: '#1a1a1e',
                        ravenLightBg: '#f8f9fa'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Custom Styles -->
    <style>
        /* Smooth Scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Glassmorphic Effects */
        .glass-nav {
            background: rgba(15, 15, 17, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Hover Zoom Effects */
        .img-zoom-container {
            overflow: hidden;
        }
        .img-zoom-container img {
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .img-zoom-container:hover img {
            transform: scale(1.08);
        }

        /* Custom Floating Contact Switch Animation */
        .fab-options {
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            opacity: 0;
            pointer-events: none;
            transform: translateY(20px) scale(0.8);
        }

        .fab-options.active {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        /* Subtle Pulse for Main FAB Button */
        @keyframes subtlePulse {
            0% { box-shadow: 0 0 0 0 rgba(244, 67, 54, 0.6); }
            70% { box-shadow: 0 0 0 15px rgba(244, 67, 54, 0); }
            100% { box-shadow: 0 0 0 0 rgba(244, 67, 54, 0); }
        }

        .fab-main-btn {
            animation: subtlePulse 2.5s infinite;
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f0f11;
        }
        ::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f44336;
        }
    </style>
</head>
<body class="bg-ravenBlack text-gray-100 font-sans antialiased overflow-x-hidden selection:bg-ravenRed selection:text-white">

    <!-- ==================== HEADER & NAVIGATION ==================== -->
    <header class="fixed top-0 left-0 w-full z-40 transition-all duration-300 glass-nav border-b border-white/10" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Brand Logo -->
            <a href="#home" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-full bg-ravenRed flex items-center justify-center font-extrabold text-xl text-white shadow-lg shadow-ravenRed/30 transition-transform group-hover:scale-105">
                    R
                </div>
                <div class="flex flex-col">
                    <span class="text-2xl font-black tracking-widest text-white uppercase leading-none">RAVEN <span class="text-ravenRed">BD</span></span>
                    <span class="text-[10px] tracking-widest text-gray-400 uppercase font-medium">Clothing Brand</span>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold tracking-wider">
                <a href="#home" class="hover:text-ravenRed transition-colors duration-200">HOME</a>
                <a href="#categories" class="hover:text-ravenRed transition-colors duration-200">CATEGORIES</a>
                <a href="#shop" class="hover:text-ravenRed transition-colors duration-200">COLLECTION</a>
                <a href="#about" class="hover:text-ravenRed transition-colors duration-200">ABOUT US</a>
                <a href="#contact" class="hover:text-ravenRed transition-colors duration-200">CONTACT</a>
            </nav>

            <!-- Quick Action CTA -->
            <div class="hidden md:flex items-center gap-4">
                <a href="https://wa.me/message/AYVEGVVRMRKZP1" target="_blank" rel="noopener noreferrer" 
                   class="px-5 py-2.5 rounded-full bg-ravenRed hover:bg-ravenDarkRed text-white font-semibold text-xs tracking-wider uppercase transition-all duration-300 shadow-lg shadow-ravenRed/20 hover:shadow-ravenRed/40 flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-lg"></i> Direct Order
                </a>
            </div>

            <!-- Mobile Hamburger Button -->
            <button id="mobileMenuBtn" aria-label="Toggle Navigation Menu" class="md:hidden text-2xl text-white focus:outline-none p-2">
                <i class="fa-solid fa-bars" id="menuIcon"></i>
            </button>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobileDrawer" class="hidden md:hidden bg-ravenGray border-b border-white/10 px-6 py-6 transition-all duration-300">
            <nav class="flex flex-col space-y-4 text-sm font-semibold tracking-wider">
                <a href="#home" class="mobile-link py-2 border-b border-white/5 hover:text-ravenRed">HOME</a>
                <a href="#categories" class="mobile-link py-2 border-b border-white/5 hover:text-ravenRed">CATEGORIES</a>
                <a href="#shop" class="mobile-link py-2 border-b border-white/5 hover:text-ravenRed">COLLECTION</a>
                <a href="#about" class="mobile-link py-2 border-b border-white/5 hover:text-ravenRed">ABOUT US</a>
                <a href="#contact" class="mobile-link py-2 border-b border-white/5 hover:text-ravenRed">CONTACT</a>
                <a href="https://wa.me/message/AYVEGVVRMRKZP1" target="_blank" rel="noopener noreferrer" class="mt-4 w-full py-3 text-center bg-ravenRed text-white rounded-lg font-bold tracking-wider uppercase flex items-center justify-center gap-2">
                    <i class="fa-brands fa-whatsapp text-lg"></i> Chat on WhatsApp
                </a>
            </nav>
        </div>
    </header>

    <!-- ==================== HERO SECTION ==================== -->
    <section id="home" class="relative min-h-screen pt-20 flex items-center justify-center overflow-hidden bg-ravenBlack">
        <!-- Background Overlay Image -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop" 
                 alt="Raven BD Hero Banner" 
                 class="w-full h-full object-cover object-center opacity-30 filter grayscale">
            <div class="absolute inset-0 bg-gradient-to-t from-ravenBlack via-ravenBlack/70 to-transparent"></div>
        </div>

        <!-- Content -->
        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-12 pb-20">
            <span class="inline-block px-4 py-1.5 rounded-full bg-ravenRed/20 border border-ravenRed/40 text-ravenRed text-xs font-bold uppercase tracking-widest mb-6">
                New Season Arrival 2026
            </span>
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight uppercase leading-none mb-6">
                OUR COLLECTION, <br class="hidden sm:inline"><span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-200 to-ravenRed">YOUR VIBE</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto font-light mb-10 leading-relaxed">
                Discover Your Style with Raven BD. Elevate your everyday look with modern streetwear, crisp casuals, and premium minimalist apparel crafted for comfort and confidence.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#shop" class="w-full sm:w-auto px-8 py-4 bg-ravenRed hover:bg-ravenDarkRed text-white font-bold rounded-lg uppercase tracking-wider text-sm transition-all duration-300 shadow-xl shadow-ravenRed/30 hover:scale-105">
                    Shop Collection <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
                </a>
                <a href="#about" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg uppercase tracking-wider text-sm backdrop-blur-md border border-white/20 transition-all duration-300">
                    Explore Our Story
                </a>
            </div>
        </div>

        <!-- Scroll Down Indicator -->
        <a href="#categories" class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-gray-400 hover:text-white transition-colors animate-bounce">
            <i class="fa-solid fa-chevron-down text-xl"></i>
        </a>
    </section>

    <!-- ==================== FEATURED CATEGORIES ==================== -->
    <section id="categories" class="py-20 bg-ravenBlack border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-xs font-bold text-ravenRed uppercase tracking-widest mb-2">Curated Styles</h2>
                <h3 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight">Featured Categories</h3>
                <div class="w-16 h-1 bg-ravenRed mx-auto mt-4 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Category 1: Men's Collection -->
                <div class="group relative rounded-xl overflow-hidden bg-ravenGray border border-white/10 img-zoom-container shadow-xl">
                    <div class="h-96 w-full">
                        <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?q=80&w=1000&auto=format&fit=crop" alt="Men's Collection" class="w-full h-full object-cover">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent p-6 flex flex-col justify-end">
                        <h4 class="text-2xl font-bold text-white uppercase mb-1">Men's Fashion</h4>
                        <p class="text-gray-300 text-xs mb-4 font-light">Jackets, Hoodies, Shirts & Essentials</p>
                        <button onclick="filterByCategory('Men')" class="w-fit px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider rounded group-hover:bg-ravenRed group-hover:text-white transition-colors">
                            Explore <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Category 2: Women's Collection -->
                <div class="group relative rounded-xl overflow-hidden bg-ravenGray border border-white/10 img-zoom-container shadow-xl">
                    <div class="h-96 w-full">
                        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop" alt="Women's Collection" class="w-full h-full object-cover">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent p-6 flex flex-col justify-end">
                        <h4 class="text-2xl font-bold text-white uppercase mb-1">Women's Fashion</h4>
                        <p class="text-gray-300 text-xs mb-4 font-light">Trendy Tops, Outerwear & Street Style</p>
                        <button onclick="filterByCategory('Women')" class="w-fit px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider rounded group-hover:bg-ravenRed group-hover:text-white transition-colors">
                            Explore <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Category 3: Streetwear -->
                <div class="group relative rounded-xl overflow-hidden bg-ravenGray border border-white/10 img-zoom-container shadow-xl sm:col-span-2 lg:col-span-1">
                    <div class="h-96 w-full">
                        <img src="https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?q=80&w=1000&auto=format&fit=crop" alt="Streetwear Collection" class="w-full h-full object-cover">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent p-6 flex flex-col justify-end">
                        <h4 class="text-2xl font-bold text-white uppercase mb-1">Streetwear & Casuals</h4>
                        <p class="text-gray-300 text-xs mb-4 font-light">Oversized Fits, Drop-Shoulder Tees & Cargo Pants</p>
                        <button onclick="filterByCategory('Streetwear')" class="w-fit px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider rounded group-hover:bg-ravenRed group-hover:text-white transition-colors">
                            Explore <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== PRODUCT CATALOGUE & FILTERING ==================== -->
    <section id="shop" class="py-20 bg-ravenGray border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                <div>
                    <h2 class="text-xs font-bold text-ravenRed uppercase tracking-widest mb-2">Our Catalogue</h2>
                    <h3 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight">Explore Collection</h3>
                </div>

                <!-- Filters & Sorting Controls -->
                <div class="mt-6 md:mt-0 flex flex-wrap items-center gap-3">
                    <!-- Filter Buttons -->
                    <div class="flex flex-wrap gap-2 text-xs font-semibold">
                        <button onclick="filterByCategory('All')" class="filter-btn active-filter px-4 py-2 rounded-lg bg-ravenRed text-white border border-ravenRed transition-all" data-category="All">All</button>
                        <button onclick="filterByCategory('Men')" class="filter-btn px-4 py-2 rounded-lg bg-ravenBlack text-gray-300 border border-white/10 hover:border-ravenRed transition-all" data-category="Men">Men</button>
                        <button onclick="filterByCategory('Women')" class="filter-btn px-4 py-2 rounded-lg bg-ravenBlack text-gray-300 border border-white/10 hover:border-ravenRed transition-all" data-category="Women">Women</button>
                        <button onclick="filterByCategory('T-Shirts')" class="filter-btn px-4 py-2 rounded-lg bg-ravenBlack text-gray-300 border border-white/10 hover:border-ravenRed transition-all" data-category="T-Shirts">T-Shirts</button>
                        <button onclick="filterByCategory('Shirts')" class="filter-btn px-4 py-2 rounded-lg bg-ravenBlack text-gray-300 border border-white/10 hover:border-ravenRed transition-all" data-category="Shirts">Shirts</button>
                        <button onclick="filterByCategory('Trousers')" class="filter-btn px-4 py-2 rounded-lg bg-ravenBlack text-gray-300 border border-white/10 hover:border-ravenRed transition-all" data-category="Trousers">Trousers</button>
                    </div>

                    <!-- Sort Select -->
                    <select id="sortSelect" onchange="sortProducts()" class="bg-ravenBlack text-gray-300 border border-white/10 text-xs rounded-lg px-3 py-2 font-semibold focus:outline-none focus:border-ravenRed">
                        <option value="default">Sort: Featured</option>
                        <option value="low-high">Price: Low to High</option>
                        <option value="high-low">Price: High to Low</option>
                        <option value="newest">Newest First</option>
                    </select>
                </div>
            </div>

            <!-- Product Grid -->
            <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Products dynamically rendered by main.js -->
            </div>
        </div>
    </section>

    <!-- ==================== ABOUT RAVEN BD ==================== -->
    <section id="about" class="py-20 bg-ravenBlack border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                
                <!-- Visual Banner -->
                <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1000&auto=format&fit=crop" alt="About Raven BD" class="w-full h-[420px] object-cover">
                    <div class="absolute inset-0 bg-gradient-to-tr from-ravenBlack/90 via-transparent to-transparent flex items-end p-8">
                        <div class="border-l-4 border-ravenRed pl-4">
                            <h4 class="text-xl font-bold text-white uppercase">Raven BD Studio</h4>
                            <p class="text-xs text-gray-400">Crafting Confidence & Quality Fashion</p>
                        </div>
                    </div>
                </div>

                <!-- Text Content -->
                <div class="space-y-6">
                    <h2 class="text-xs font-bold text-ravenRed uppercase tracking-widest">Brand Narrative</h2>
                    <h3 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight">About Raven BD</h3>
                    <p class="text-gray-300 font-light leading-relaxed text-base">
                        Raven BD is a fashion brand focused on bringing stylish, comfortable and quality clothing to everyone. We believe fashion is more than clothing — it is a way to express your personality.
                    </p>
                    <p class="text-gray-400 font-light text-sm leading-relaxed">
                        Based out of Sirajganj, Bangladesh, we bring minimalist elegance, premium fabrics, and precise tailor-fitting right to your doorstep. Every piece in our catalogue is curated to keep up with global streetwear trends while delivering everyday versatility.
                    </p>

                    <!-- Feature Cards (Why Choose Us) -->
                    <div class="grid grid-cols-2 gap-4 pt-4">
                        <div class="p-4 rounded-xl bg-ravenGray border border-white/5">
                            <i class="fa-solid fa-shirt text-ravenRed text-xl mb-2"></i>
                            <h5 class="text-sm font-bold text-white uppercase">Stylish Collections</h5>
                            <p class="text-xs text-gray-400 font-light">Modern drop fits & classic cuts</p>
                        </div>
                        <div class="p-4 rounded-xl bg-ravenGray border border-white/5">
                            <i class="fa-solid fa-gem text-ravenRed text-xl mb-2"></i>
                            <h5 class="text-sm font-bold text-white uppercase">Quality Focused</h5>
                            <p class="text-xs text-gray-400 font-light">100% premium cotton & fabrics</p>
                        </div>
                        <div class="p-4 rounded-xl bg-ravenGray border border-white/5">
                            <i class="fa-solid fa-[#25D366] text-emerald-400 text-xl mb-2"></i>
                            <h5 class="text-sm font-bold text-white uppercase">Easy WhatsApp Order</h5>
                            <p class="text-xs text-gray-400 font-light">Instant chat & order confirmation</p>
                        </div>
                        <div class="p-4 rounded-xl bg-ravenGray border border-white/5">
                            <i class="fa-solid fa-truck-fast text-ravenRed text-xl mb-2"></i>
                            <h5 class="text-sm font-bold text-white uppercase">Reliable Delivery</h5>
                            <p class="text-xs text-gray-400 font-light">Fast shipping across Bangladesh</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ==================== CONTACT SECTION ==================== -->
    <section id="contact" class="py-20 bg-ravenGray border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-xs font-bold text-ravenRed uppercase tracking-widest mb-2">Get In Touch</h2>
                <h3 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight">Contact & Order Info</h3>
                <div class="w-16 h-1 bg-ravenRed mx-auto mt-4 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Phone Call Card -->
                <a href="tel:+8801640047589" class="p-8 rounded-2xl bg-ravenBlack border border-white/10 hover:border-ravenRed transition-all text-center group shadow-lg">
                    <div class="w-14 h-14 rounded-full bg-ravenRed/10 text-ravenRed flex items-center justify-center text-2xl mx-auto mb-4 group-hover:scale-110 group-hover:bg-ravenRed group-hover:text-white transition-all">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <h4 class="text-lg font-bold text-white uppercase mb-1">Direct Call</h4>
                    <p class="text-xs text-gray-400 mb-3">Available for Customer Assistance</p>
                    <span class="text-ravenRed font-bold text-sm tracking-wider">01640047589</span>
                </a>

                <!-- WhatsApp Card -->
                <a href="https://wa.me/message/AYVEGVVRMRKZP1" target="_blank" rel="noopener noreferrer" class="p-8 rounded-2xl bg-ravenBlack border border-white/10 hover:border-emerald-500 transition-all text-center group shadow-lg">
                    <div class="w-14 h-14 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-2xl mx-auto mb-4 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <h4 class="text-lg font-bold text-white uppercase mb-1">WhatsApp Chat</h4>
                    <p class="text-xs text-gray-400 mb-3">Instant Ordering & Inquiries</p>
                    <span class="text-emerald-400 font-bold text-sm tracking-wider">Message Now</span>
                </a>

                <!-- Location / Address Card -->
                <div class="p-8 rounded-2xl bg-ravenBlack border border-white/10 text-center shadow-lg">
                    <div class="w-14 h-14 rounded-full bg-ravenRed/10 text-ravenRed flex items-center justify-center text-2xl mx-auto mb-4">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <h4 class="text-lg font-bold text-white uppercase mb-1">Store Location</h4>
                    <p class="text-xs text-gray-400 mb-2">Visit / Dispatch Hub</p>
                    <span class="text-gray-200 font-medium text-sm">Ullapara, Sirajganj, Bangladesh</span>
                </div>
            </div>

            <!-- Quick Links Banner -->
            <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-ravenRed/20 via-ravenBlack to-ravenRed/20 border border-ravenRed/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <i class="fa-brands fa-facebook text-3xl text-blue-500"></i>
                    <div>
                        <h5 class="text-sm font-bold text-white uppercase">Follow Us on Facebook</h5>
                        <p class="text-xs text-gray-400">Stay updated on new drops and discounts</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <a href="https://www.facebook.com/rainbirdcollection" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider transition-colors">
                        Facebook Page
                    </a>
                    <a href="https://wa.me/c/8801640047589" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider transition-colors">
                        WhatsApp Catalogue
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FOOTER ==================== -->
    <footer class="bg-ravenBlack border-t border-white/10 pt-16 pb-8 text-gray-400">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
                
                <!-- Brand Info -->
                <div class="space-y-4 md:col-span-1">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-ravenRed flex items-center justify-center font-extrabold text-sm text-white">R</div>
                        <span class="text-xl font-black text-white uppercase tracking-widest">RAVEN <span class="text-ravenRed">BD</span></span>
                    </div>
                    <p class="text-xs leading-relaxed font-light">
                        Simple, stylish, elegant and trustworthy fashion brand based in Bangladesh. Elevating your daily casual & streetwear lifestyle.
                    </p>
                </div>

                <!-- Quick Navigation -->
                <div>
                    <h5 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-ravenRed pl-3">Navigation</h5>
                    <ul class="space-y-2 text-xs">
                        <li><a href="#home" class="hover:text-ravenRed transition-colors">Home</a></li>
                        <li><a href="#categories" class="hover:text-ravenRed transition-colors">Featured Categories</a></li>
                        <li><a href="#shop" class="hover:text-ravenRed transition-colors">Product Catalogue</a></li>
                        <li><a href="#about" class="hover:text-ravenRed transition-colors">About Us</a></li>
                        <li><a href="#contact" class="hover:text-ravenRed transition-colors">Contact</a></li>
                    </ul>
                </div>

                <!-- Collections -->
                <div>
                    <h5 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-ravenRed pl-3">Collections</h5>
                    <ul class="space-y-2 text-xs">
                        <li><button onclick="filterByCategory('Men')" class="hover:text-ravenRed transition-colors">Men's Fashion</button></li>
                        <li><button onclick="filterByCategory('Women')" class="hover:text-ravenRed transition-colors">Women's Fashion</button></li>
                        <li><button onclick="filterByCategory('T-Shirts')" class="hover:text-ravenRed transition-colors">T-Shirts</button></li>
                        <li><button onclick="filterByCategory('Trousers')" class="hover:text-ravenRed transition-colors">Trousers & Pants</button></li>
                    </ul>
                </div>

                <!-- Socials & Official Info -->
                <div>
                    <h5 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-ravenRed pl-3">Connect With Us</h5>
                    <p class="text-xs mb-3">Ullapara, Sirajganj, Bangladesh</p>
                    <div class="flex space-x-3 mb-4">
                        <a href="https://www.facebook.com/rainbirdcollection" target="_blank" aria-label="Facebook Page" class="w-9 h-9 rounded-full bg-white/5 hover:bg-ravenRed hover:text-white flex items-center justify-center transition-colors">
                            <i class="fa-brands fa-facebook-f text-sm"></i>
                        </a>
                        <a href="https://wa.me/message/AYVEGVVRMRKZP1" target="_blank" aria-label="WhatsApp Chat" class="w-9 h-9 rounded-full bg-white/5 hover:bg-emerald-500 hover:text-white flex items-center justify-center transition-colors">
                            <i class="fa-brands fa-whatsapp text-sm"></i>
                        </a>
                        <a href="https://m.me/rainbirdcollection" target="_blank" aria-label="Messenger" class="w-9 h-9 rounded-full bg-white/5 hover:bg-blue-500 hover:text-white flex items-center justify-center transition-colors">
                            <i class="fa-brands fa-facebook-messenger text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="border-t border-white/5 pt-8 text-center text-xs text-gray-500">
                <p>&copy; 2026 Raven BD. All Rights Reserved. Crafted for Style & Excellence.</p>
            </div>
        </div>
    </footer>


    <!-- ==================== QUICK VIEW PRODUCT MODAL ==================== -->
    <div id="productModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity">
        <div class="bg-ravenGray border border-white/10 rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl relative transform transition-all scale-95 opacity-0" id="modalContent">
            
            <!-- Close Button -->
            <button onclick="closeProductModal()" class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/50 text-white hover:bg-ravenRed transition-colors flex items-center justify-center">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <div class="grid grid-cols-1 md:grid-cols-2">
                <!-- Modal Image -->
                <div class="h-72 md:h-full bg-black">
                    <img id="modalImg" src="" alt="Product Detail" class="w-full h-full object-cover">
                </div>

                <!-- Modal Info -->
                <div class="p-6 md:p-8 flex flex-col justify-between">
                    <div>
                        <span id="modalCategory" class="text-[10px] font-bold text-ravenRed uppercase tracking-widest px-2 py-0.5 rounded bg-ravenRed/10 border border-ravenRed/20 inline-block mb-2">Category</span>
                        <h3 id="modalTitle" class="text-2xl font-extrabold text-white uppercase tracking-tight mb-2">Product Name</h3>
                        <p id="modalPrice" class="text-xl font-black text-ravenRed mb-4">৳ 0.00</p>
                        
                        <p id="modalDesc" class="text-xs text-gray-300 leading-relaxed font-light mb-6">
                            Product description goes here.
                        </p>

                        <!-- Sizes -->
                        <div class="mb-4">
                            <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Available Sizes</label>
                            <div id="modalSizes" class="flex flex-wrap gap-2">
                                <!-- Sizes rendered dynamically -->
                            </div>
                        </div>

                        <!-- Colors -->
                        <div class="mb-6">
                            <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Available Colors</label>
                            <div id="modalColors" class="flex flex-wrap gap-2 text-xs text-gray-300">
                                <!-- Colors rendered dynamically -->
                            </div>
                        </div>
                    </div>

                    <!-- Direct Order Action -->
                    <a id="modalWhatsappBtn" href="#" target="_blank" rel="noopener noreferrer" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-colors">
                        <i class="fa-brands fa-whatsapp text-lg"></i> Order via WhatsApp
                    </a>
                </div>
            </div>

        </div>
    </div>


    <!-- ==================== FLOATING CONTACT SWITCH (FAB) ==================== -->
    <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
        
        <!-- Expanded Contact Options -->
        <div id="fabOptions" class="fab-options flex flex-col items-end space-y-3 mb-4">
            
            <!-- Option 1: Direct Call -->
            <a href="tel:+8801640047589" class="flex items-center gap-3 group">
                <span class="bg-ravenBlack text-white text-xs font-bold px-3 py-1.5 rounded-md shadow-lg border border-white/10 group-hover:border-ravenRed transition-all">
                    Call: 01640047589
                </span>
                <div class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center text-xl shadow-lg transition-transform group-hover:scale-110">
                    <i class="fa-solid fa-phone"></i>
                </div>
            </a>

            <!-- Option 2: WhatsApp -->
            <a href="https://wa.me/message/AYVEGVVRMRKZP1" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
                <span class="bg-ravenBlack text-white text-xs font-bold px-3 py-1.5 rounded-md shadow-lg border border-white/10 group-hover:border-emerald-500 transition-all">
                    WhatsApp Chat
                </span>
                <div class="w-12 h-12 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xl shadow-lg transition-transform group-hover:scale-110">
                    <i class="fa-brands fa-whatsapp"></i>
                </div>
            </a>

            <!-- Option 3: Messenger -->
            <a href="https://m.me/rainbirdcollection" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
                <span class="bg-ravenBlack text-white text-xs font-bold px-3 py-1.5 rounded-md shadow-lg border border-white/10 group-hover:border-blue-400 transition-all">
                    Messenger
                </span>
                <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-blue-600 to-purple-500 text-white flex items-center justify-center text-xl shadow-lg transition-transform group-hover:scale-110">
                    <i class="fa-brands fa-facebook-messenger"></i>
                </div>
            </a>
        </div>

        <!-- Main Floating Action Trigger Button -->
        <button id="fabMainBtn" aria-label="Contact Switcher" onclick="toggleFabMenu()" class="fab-main-btn w-14 h-14 rounded-full bg-ravenRed text-white flex items-center justify-center text-2xl shadow-2xl focus:outline-none transition-transform active:scale-95">
            <i class="fa-solid fa-headset" id="fabIcon"></i>
        </button>
    </div>


    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        /* ----------------------------------------------------
           1. PRODUCT DATASET (Demo Catalogue Data)
           Easily customizable: replace title, price, images, etc.
        ---------------------------------------------------- */
        const products = [
            {
                id: 1,
                name: "Raven Minimalist Drop-Shoulder Tee",
                category: "T-Shirts",
                gender: "Men",
                price: 750,
                isNew: true,
                sizes: ["M", "L", "XL"],
                colors: ["Black", "Charcoal White"],
                image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=1000&auto=format&fit=crop",
                description: "Premium heavy-weight cotton drop-shoulder streetwear t-shirt. Breathable, durable, and styled for modern effortless streetwear vibes."
            },
            {
                id: 2,
                name: "Urban Tactical Cargo Trousers",
                category: "Trousers",
                gender: "Men",
                price: 1450,
                isNew: true,
                sizes: ["30", "32", "34", "36"],
                colors: ["Matte Black", "Olive Green"],
                image: "https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?q=80&w=1000&auto=format&fit=crop",
                description: "Multi-pocket durable cotton twill cargo pants. Relaxed fit design offering max mobility and modern utility aesthetics."
            },
            {
                id: 3,
                name: "Raven Oversized Graphic Hoodie",
                category: "Streetwear",
                gender: "Unisex",
                price: 1850,
                isNew: false,
                sizes: ["M", "L", "XL", "XXL"],
                colors: ["Deep Red", "Jet Black"],
                image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=1000&auto=format&fit=crop",
                description: "Fleece lined high-density cotton blend hoodie featuring minimalist signature Raven back graphic print."
            },
            {
                id: 4,
                name: "Classic Oxford Casual Shirt",
                category: "Shirts",
                gender: "Men",
                price: 1200,
                isNew: false,
                sizes: ["M", "L", "XL"],
                colors: ["Pure White", "Soft Gray"],
                image: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?q=80&w=1000&auto=format&fit=crop",
                description: "Tailored slim fit oxford shirt crafted from 100% breathable cotton. Perfect for modern smart-casual occasions."
            },
            {
                id: 5,
                name: "Minimalist Cropped Denim Jacket",
                category: "Women",
                gender: "Women",
                price: 2100,
                isNew: true,
                sizes: ["S", "M", "L"],
                colors: ["Washed Black", "Vintange Blue"],
                image: "https://images.unsplash.com/photo-1544441893-675973e31985?q=80&w=1000&auto=format&fit=crop",
                description: "Trendy cropped structure jacket designed with premium wash cotton denim. Includes custom matte black buttons."
            },
            {
                id: 6,
                name: "Raven Red Accent Signature Tee",
                category: "T-Shirts",
                gender: "Unisex",
                price: 690,
                isNew: false,
                sizes: ["S", "M", "L", "XL"],
                colors: ["Raven Black/Red"],
                image: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?q=80&w=1000&auto=format&fit=crop",
                description: "Essential crewneck graphic t-shirt featuring the iconic Raven Red chest motif. Soft combed cotton finish."
            },
            {
                id: 7,
                name: "Relaxed Fit Chino Trousers",
                category: "Trousers",
                gender: "Men",
                price: 1350,
                isNew: false,
                sizes: ["30", "32", "34"],
                colors: ["Beige", "Black"],
                image: "https://images.unsplash.com/photo-1473966968600-fa801b869a1a?q=80&w=1000&auto=format&fit=crop",
                description: "Versatile casual chinos constructed with slight stretch cotton flex for all-day workspace or hangout comfort."
            },
            {
                id: 8,
                name: "Women's Oversized Street Sweatshirt",
                category: "Women",
                gender: "Women",
                price: 1550,
                isNew: true,
                sizes: ["S", "M", "L"],
                colors: ["Cream", "Charcoal Black"],
                image: "https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1000&auto=format&fit=crop",
                description: "Cozy relaxed fit pullover crewneck. Features plush interior lining for warmth during cool seasonal evenings."
            }
        ];

        let activeCategory = 'All';
        let currentProducts = [...products];

        /* ----------------------------------------------------
           2. RENDER PRODUCTS TO GRID
        ---------------------------------------------------- */
        function renderProducts(items) {
            const container = document.getElementById('productGrid');
            container.innerHTML = '';

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-12">
                        <i class="fa-solid fa-box-open text-4xl text-gray-600 mb-3"></i>
                        <p class="text-gray-400 font-light text-sm">No products found in this category.</p>
                    </div>
                `;
                return;
            }

            items.forEach(product => {
                const waMessage = encodeURIComponent(`Hello Raven BD, I want to inquire/order: ${product.name} (Price: ৳${product.price})`);
                const waLink = `https://wa.me/8801640047589?text=${waMessage}`;

                const cardHTML = `
                    <div class="bg-ravenBlack border border-white/10 rounded-xl overflow-hidden group hover:border-ravenRed/50 transition-all duration-300 flex flex-col justify-between shadow-lg">
                        
                        <!-- Image Wrapper -->
                        <div class="relative h-72 w-full overflow-hidden bg-gray-900">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                            
                            ${product.isNew ? `<span class="absolute top-3 left-3 bg-ravenRed text-white text-[10px] font-extrabold uppercase px-2.5 py-1 rounded tracking-widest">NEW</span>` : ''}
                            
                            <!-- Quick View Overlay -->
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                <button onclick="openProductModal(${product.id})" class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider rounded-md hover:bg-ravenRed hover:text-white transition-colors shadow-lg">
                                    <i class="fa-solid fa-eye mr-1"></i> Details
                                </button>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">${product.category}</span>
                                <h4 class="text-base font-bold text-white uppercase tracking-tight mt-1 line-clamp-1 group-hover:text-ravenRed transition-colors">${product.name}</h4>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-lg font-black text-ravenRed">৳ ${product.price}</span>
                                </div>
                            </div>

                            <div class="mt-4 pt-4 border-t border-white/5 flex items-center gap-2">
                                <button onclick="openProductModal(${product.id})" class="flex-1 py-2.5 rounded-lg bg-white/5 hover:bg-white/10 text-white font-semibold text-xs uppercase tracking-wider transition-colors border border-white/10">
                                    Details
                                </button>
                                <a href="${waLink}" target="_blank" rel="noopener noreferrer" class="flex-1 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-1">
                                    <i class="fa-brands fa-whatsapp text-sm"></i> Order
                                </a>
                            </div>
                        </div>

                    </div>
                `;
                container.insertAdjacentHTML('beforeend', cardHTML);
            });
        }

        /* ----------------------------------------------------
           3. FILTERING & SORTING LOGIC
        ---------------------------------------------------- */
        function filterByCategory(category) {
            activeCategory = category;

            // Update UI filter button states
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-category') === category) {
                    btn.classList.add('bg-ravenRed', 'text-white', 'border-ravenRed');
                    btn.classList.remove('bg-ravenBlack', 'text-gray-300');
                } else {
                    btn.classList.remove('bg-ravenRed', 'text-white', 'border-ravenRed');
                    btn.classList.add('bg-ravenBlack', 'text-gray-300');
                }
            });

            if (category === 'All') {
                currentProducts = [...products];
            } else if (category === 'Men' || category === 'Women') {
                currentProducts = products.filter(p => p.gender === category || p.gender === 'Unisex');
            } else {
                currentProducts = products.filter(p => p.category === category);
            }

            sortProducts();
        }

        function sortProducts() {
            const sortVal = document.getElementById('sortSelect').value;
            let sorted = [...currentProducts];

            if (sortVal === 'low-high') {
                sorted.sort((a, b) => a.price - b.price);
            } else if (sortVal === 'high-low') {
                sorted.sort((a, b) => b.price - a.price);
            } else if (sortVal === 'newest') {
                sorted.sort((a, b) => (b.isNew === a.isNew) ? 0 : b.isNew ? 1 : -1);
            }

            renderProducts(sorted);
        }

        /* ----------------------------------------------------
           4. PRODUCT QUICK VIEW MODAL LOGIC
        ---------------------------------------------------- */
        function openProductModal(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            document.getElementById('modalImg').src = product.image;
            document.getElementById('modalCategory').textContent = product.category;
            document.getElementById('modalTitle').textContent = product.name;
            document.getElementById('modalPrice').textContent = `৳ ${product.price}`;
            document.getElementById('modalDesc').textContent = product.description;

            // Render Sizes
            const sizesContainer = document.getElementById('modalSizes');
            sizesContainer.innerHTML = product.sizes.map(s => 
                `<span class="px-3 py-1 rounded bg-ravenBlack border border-white/20 text-xs font-bold text-gray-200">${s}</span>`
            ).join('');

            // Render Colors
            const colorsContainer = document.getElementById('modalColors');
            colorsContainer.innerHTML = product.colors.map(c => 
                `<span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 text-xs text-gray-300">${c}</span>`
            ).join('');

            // WhatsApp Direct Link
            const waMessage = encodeURIComponent(`Hello Raven BD, I am interested in ordering: ${product.name} (Price: ৳${product.price})`);
            document.getElementById('modalWhatsappBtn').href = `https://wa.me/8801640047589?text=${waMessage}`;

            const modal = document.getElementById('productModal');
            const modalContent = document.getElementById('modalContent');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeProductModal() {
            const modal = document.getElementById('productModal');
            const modalContent = document.getElementById('modalContent');

            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Close Modal when clicking background overlay
        document.getElementById('productModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeProductModal();
            }
        });

        /* ----------------------------------------------------
           5. FLOATING CONTACT SWITCH (FAB) CONTROLLER
        ---------------------------------------------------- */
        let isFabOpen = false;
        function toggleFabMenu() {
            const options = document.getElementById('fabOptions');
            const icon = document.getElementById('fabIcon');
            
            isFabOpen = !isFabOpen;
            
            if (isFabOpen) {
                options.classList.add('active');
                icon.className = 'fa-solid fa-xmark';
            } else {
                options.classList.remove('active');
                icon.className = 'fa-solid fa-headset';
            }
        }

        // Close FAB menu when clicking outside
        document.addEventListener('click', function(e) {
            const fabContainer = e.target.closest('.fixed.bottom-6.right-6');
            if (!fabContainer && isFabOpen) {
                toggleFabMenu();
            }
        });

        /* ----------------------------------------------------
           6. MOBILE NAVIGATION DRAWER TOGGLE
        ---------------------------------------------------- */
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileDrawer = document.getElementById('mobileDrawer');
        const menuIcon = document.getElementById('menuIcon');

        mobileMenuBtn.addEventListener('click', () => {
            mobileDrawer.classList.toggle('hidden');
            if (mobileDrawer.classList.contains('hidden')) {
                menuIcon.className = 'fa-solid fa-bars';
            } else {
                menuIcon.className = 'fa-solid fa-xmark';
            }
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileDrawer.classList.add('hidden');
                menuIcon.className = 'fa-solid fa-bars';
            });
        });

        /* ----------------------------------------------------
           7. INITIALIZATION ON LOAD
        ---------------------------------------------------- */
        window.addEventListener('DOMContentLoaded', () => {
            renderProducts(products);
        });
    </script>
</body>
</html>
